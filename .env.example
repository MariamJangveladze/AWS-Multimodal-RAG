RAG_RUNTIME_MODE=local
RAG_AWS_REGION=eu-central-1
RAG_S3_BUCKET=replace-me
RAG_FAISS_INDEX_KEY=index/amo_index.faiss
RAG_METADATA_KEY=index/items.json
RAG_EMBEDDING_MODEL_ID=amazon.nova-2-multimodal-embeddings-v1:0
RAG_GENERATION_MODEL_ID=us.amazon.nova-pro-v1:0
RAG_EMBEDDING_DIMENSION=1024
RAG_TOP_K=5
RAG_MAX_QUERY_CHARACTERS=2000
RAG_API_TOKEN=replace-with-a-long-random-local-token
RAG_MAX_IMAGE_BYTES=5000000
RAG_PRESIGNED_URL_TTL_SECONDS=900

# Set these to the prices for your enabled model and AWS region.
RAG_INPUT_COST_PER_MILLION_TOKENS=0
RAG_OUTPUT_COST_PER_MILLION_TOKENS=0
